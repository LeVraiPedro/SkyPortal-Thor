"""Integrate the V6 animated portal into the existing screen and documentation."""

from pathlib import Path


def replace_once(path: str, old: str, new: str) -> None:
    file_path = Path(path)
    text = file_path.read_text(encoding="utf-8")
    count = text.count(old)
    if count != 1:
        raise RuntimeError(
            f"{path}: expected exactly one replacement target, found {count}"
        )
    file_path.write_text(text.replace(old, new, 1), encoding="utf-8")
    print(f"updated: {path}")


def main() -> None:
    screen = "app/src/main/java/com/skyportalthor/app/ui/PortalScreen.kt"
    replace_once(
        screen,
        """import com.skyportalthor.app.portal.PortalState
import kotlinx.coroutines.delay
""",
