+// Menu preparation can run while EmulationActivity is still using IOS (including on
+// another display). Never create a second Kernel, nor inspect an IOS being torn down.
+static IOS::ES::TMDReader GetSystemMenuTMDWhenIdle()
+{
+  auto& system = Core::System::GetInstance();
+  if (!Core::IsUninitialized(system))
+    return {};
+
+  // On this JNI/UI thread the guard takes the same core mutex as Init/Stop. Check
+  // again under that lock so a boot between the fast check and the lock is safe.
+  const Core::CPUThreadGuard guard(system);
+  if (!Core::IsUninitialized(system))
+    return {};
+
+  IOS::HLE::Kernel ios;
+  return ios.GetESCore().FindInstalledTMD(Titles::SYSTEM_MENU);
+}
