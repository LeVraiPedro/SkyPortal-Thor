+JNIEXPORT jintArray JNICALL
+Java_org_dolphinemu_dolphinemu_features_skylanders_SkylanderConfig_getPortalSnapshot(JNIEnv* env,
+                                                                                     jclass clazz)
+{
+  // Keep file ownership and the USB protocol state as separate values. A replacement queues
+  // REMOVING -> REMOVED -> ADDED -> READY while the new file is already open, so encoding
+  // `mounted` by zeroing status creates a false empty slot during that transition.
+  constexpr jsize snapshot_stride = 5;
+  constexpr size_t slot_offset = 0;
+  constexpr size_t mounted_offset = 1;
+  constexpr size_t status_offset = 2;
+  constexpr size_t figure_id_offset = 3;
+  constexpr size_t variant_id_offset = 4;
+  const auto snapshot = Core::System::GetInstance().GetSkylanderPortal().GetSlotSnapshot();
+  std::array<jint, MAX_SKYLANDERS * snapshot_stride> packed{};
+  for (u8 slot = 0; slot < MAX_SKYLANDERS; ++slot)
+  {
+    const auto& entry = snapshot[slot];
+    const size_t offset = slot * snapshot_stride;
+    packed[offset + slot_offset] = slot;
+    packed[offset + mounted_offset] = entry.mounted ? 1 : 0;
+    packed[offset + status_offset] = entry.status;
+    packed[offset + figure_id_offset] = entry.figure_id;
+    packed[offset + variant_id_offset] = entry.variant_id;
+  }
+  jintArray result = env->NewIntArray(static_cast<jsize>(packed.size()));
+  env->SetIntArrayRegion(result, 0, static_cast<jsize>(packed.size()), packed.data());
+  return result;
+}
