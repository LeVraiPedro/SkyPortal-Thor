+TEST(Skylanders, AdditionalLoadDoesNotReuseMountedReplacementSlot)
+{
+  const std::string temp_dir = File::CreateTempDir();
+  Common::ScopeGuard cleanup([&] { File::DeleteDirRecursively(temp_dir); });
+  IOS::HLE::USB::SkylanderPortal portal;
+
+  auto first = std::make_unique<IOS::HLE::USB::SkylanderFigure>(temp_dir + "/first.sky");
+  ASSERT_TRUE(first->Create(16, 0, std::array<u8, 4>{0x21, 0x22, 0x23, 0x24}));
+  const u8 first_slot = portal.LoadSkylander(std::move(first));
+  ASSERT_NE(first_slot, 0xFF);
+  portal.GetStatus();
+  portal.GetStatus();
+
+  auto second = std::make_unique<IOS::HLE::USB::SkylanderFigure>(temp_dir + "/second.sky");
+  ASSERT_TRUE(second->Create(18, 0, std::array<u8, 4>{0x25, 0x26, 0x27, 0x28}));
+  ASSERT_TRUE(portal.RemoveSkylander(first_slot));
+  ASSERT_EQ(portal.LoadSkylander(std::move(second)), first_slot);
+
+  // Advance to the exact state that exposed the old bug: B remains open while the protocol status
+  // reports A as REMOVED. The old `(status & READY) == 0` allocator considered this slot free.
+  portal.GetStatus();
+  portal.GetStatus();
+  auto snapshot = portal.GetSlotSnapshot();
+  ASSERT_TRUE(snapshot[first_slot].mounted);
+  ASSERT_EQ(snapshot[first_slot].status, IOS::HLE::USB::Skylander::REMOVED);
+  ASSERT_EQ(snapshot[first_slot].figure_id, 18);
+
+  // Loading C without explicitly replacing B must allocate another physical portal slot.
+  auto third = std::make_unique<IOS::HLE::USB::SkylanderFigure>(temp_dir + "/third.sky");
+  ASSERT_TRUE(third->Create(19, 0, std::array<u8, 4>{0x29, 0x2A, 0x2B, 0x2C}));
+  const u8 third_slot = portal.LoadSkylander(std::move(third));
+  ASSERT_NE(third_slot, 0xFF);
+  ASSERT_NE(third_slot, first_slot);
+
+  snapshot = portal.GetSlotSnapshot();
+  EXPECT_TRUE(snapshot[first_slot].mounted);
+  EXPECT_EQ(snapshot[first_slot].figure_id, 18);
+  EXPECT_TRUE(snapshot[third_slot].mounted);
+  EXPECT_EQ(snapshot[third_slot].figure_id, 19);
+
+  EXPECT_TRUE(portal.RemoveSkylander(first_slot));
+  EXPECT_TRUE(portal.RemoveSkylander(third_slot));
+}
