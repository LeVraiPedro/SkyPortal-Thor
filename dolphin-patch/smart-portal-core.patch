+u32 SkylanderUSB::GetEmulatedDeviceState(const EmulatedDeviceKind kind) const
+{
+  if (kind != EmulatedDeviceKind::SkylandersPortal)
+    return 0;
+
+  constexpr u32 present = 1 << 0;
+  constexpr u32 attached = 1 << 1;
+  constexpr u32 handshake_seen = 1 << 2;
+  u32 state = present;
+  const bool has_protocol_traffic = m_protocol_traffic_seen.load(std::memory_order_acquire);
+  if (has_protocol_traffic || m_device_attached.load(std::memory_order_acquire))
+    state |= attached;
+  if (has_protocol_traffic)
+    state |= handshake_seen;
+  return state;
+}
