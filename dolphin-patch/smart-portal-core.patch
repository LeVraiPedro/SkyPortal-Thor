+JNIEXPORT jobjectArray JNICALL
+Java_org_dolphinemu_dolphinemu_features_skylanders_SkylanderConfig_getSkylanderCatalog(JNIEnv* env,
+                                                                                       jclass clazz)
+{
+  jclass string_class = env->FindClass("java/lang/String");
+  jobjectArray result = env->NewObjectArray(
+      static_cast<jsize>(IOS::HLE::USB::list_skylanders.size()), string_class, nullptr);
+  jsize index = 0;
+  for (const auto& [ids, data] : IOS::HLE::USB::list_skylanders)
+  {
+    const std::string packed = fmt::format(
+        "{}|{}|{}|{}|{}|{}", ids.first, ids.second, data.name, static_cast<int>(data.game),
+        static_cast<int>(data.element), static_cast<int>(data.type));
+    env->SetObjectArrayElement(result, index++, ToJString(env, packed));
+  }
+  return result;
+}
