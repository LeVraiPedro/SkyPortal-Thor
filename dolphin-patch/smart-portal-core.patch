+TEST(Skylanders, RemovalDuringReplacementCancelsPendingAddition)
+{
+  const std::string temp_dir = File::CreateTempDir();
+  Common::ScopeGuard cleanup([&] { File::DeleteDirRecursively(temp_dir); });
+  IOS::HLE::USB::SkylanderPortal portal;
+
+  auto first = std::make_unique<IOS::HLE::USB::SkylanderFigure>(temp_dir + "/first.sky");
+  ASSERT_TRUE(first->Create(16, 0, std::array<u8, 4>{0x11, 0x12, 0x13, 0x14}));
+  const u8 slot = portal.LoadSkylander(std::move(first));
+  ASSERT_NE(slot, 0xFF);
+  portal.GetStatus();
+  portal.GetStatus();
+
+  auto second = std::make_unique<IOS::HLE::USB::SkylanderFigure>(temp_dir + "/second.sky");
+  ASSERT_TRUE(second->Create(18, 0, std::array<u8, 4>{0x15, 0x16, 0x17, 0x18}));
+  ASSERT_TRUE(portal.RemoveSkylander(slot));
+  ASSERT_EQ(portal.LoadSkylander(std::move(second)), slot);
+  portal.GetStatus();
+  ASSERT_EQ(portal.GetSlotSnapshot()[slot].status, IOS::HLE::USB::Skylander::REMOVING);
+
+  // Removing B before A's replacement queue is drained must close B and discard its pending
+  // ADDED/READY notifications.
+  ASSERT_TRUE(portal.RemoveSkylander(slot));
+  EXPECT_FALSE(portal.GetSlotSnapshot()[slot].mounted);
+  portal.GetStatus();
+  portal.GetStatus();
+  const auto final_snapshot = portal.GetSlotSnapshot();
+  EXPECT_FALSE(final_snapshot[slot].mounted);
+  EXPECT_EQ(final_snapshot[slot].status, IOS::HLE::USB::Skylander::REMOVED);
+}
