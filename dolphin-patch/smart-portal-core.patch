+TEST(Skylanders, ReplacementSnapshotSeparatesMountFromProtocolStatus)
+{
+  const std::string temp_dir = File::CreateTempDir();
+  Common::ScopeGuard cleanup([&] { File::DeleteDirRecursively(temp_dir); });
+  IOS::HLE::USB::SkylanderPortal portal;
+
+  auto first = std::make_unique<IOS::HLE::USB::SkylanderFigure>(temp_dir + "/first.sky");
+  ASSERT_TRUE(first->Create(16, 0, std::array<u8, 4>{0x01, 0x02, 0x03, 0x04}));
+  const u8 slot = portal.LoadSkylander(std::move(first));
+  ASSERT_NE(slot, 0xFF);
+
+  // Consume the initial ADDED/READY notifications so the first figure is stable.
+  portal.GetStatus();
+  portal.GetStatus();
+  auto snapshot = portal.GetSlotSnapshot();
+  ASSERT_TRUE(snapshot[slot].mounted);
+  ASSERT_EQ(snapshot[slot].status, IOS::HLE::USB::Skylander::READY);
+  ASSERT_EQ(snapshot[slot].figure_id, 16);
+
+  auto second = std::make_unique<IOS::HLE::USB::SkylanderFigure>(temp_dir + "/second.sky");
+  ASSERT_TRUE(second->Create(18, 0, std::array<u8, 4>{0x05, 0x06, 0x07, 0x08}));
+  ASSERT_TRUE(portal.RemoveSkylander(slot));
+  ASSERT_EQ(portal.LoadSkylander(std::move(second)), slot);
+
+  // The new file is already owned by Dolphin while the game still receives the complete
+  // transition for the replaced figure.
+  constexpr std::array<u8, 4> expected_statuses = {
+      IOS::HLE::USB::Skylander::REMOVING, IOS::HLE::USB::Skylander::REMOVED,
+      IOS::HLE::USB::Skylander::ADDED, IOS::HLE::USB::Skylander::READY};
+  for (const u8 expected_status : expected_statuses)
+  {
+    portal.GetStatus();
+    snapshot = portal.GetSlotSnapshot();
+    EXPECT_TRUE(snapshot[slot].mounted);
+    EXPECT_EQ(snapshot[slot].status, expected_status);
+    EXPECT_EQ(snapshot[slot].figure_id, 18);
+    EXPECT_EQ(snapshot[slot].variant_id, 0);
+  }
+
+  ASSERT_TRUE(portal.RemoveSkylander(slot));
+  snapshot = portal.GetSlotSnapshot();
+  EXPECT_FALSE(snapshot[slot].mounted);
+  EXPECT_EQ(snapshot[slot].status, IOS::HLE::USB::Skylander::REMOVING);
+}
