+std::array<SkylanderSlotSnapshot, MAX_SKYLANDERS> SkylanderPortal::GetSlotSnapshot()
+{
+  std::lock_guard lock(sky_mutex);
+  std::array<SkylanderSlotSnapshot, MAX_SKYLANDERS> snapshot{};
+  for (u8 slot = 0; slot < MAX_SKYLANDERS; ++slot)
+  {
+    const auto& skylander = skylanders[slot];
+    auto& entry = snapshot[slot];
+    entry.status = skylander.status;
+    entry.occupied = skylander.figure && skylander.figure->FileIsOpen() &&
+                     (skylander.status & Skylander::READY);
+    if (entry.occupied)
+    {
+      const FigureData data = skylander.figure->GetData();
+      entry.figure_id = data.figure_id;
+      entry.variant_id = data.variant_id;
+    }
+  }
+  return snapshot;
+}
