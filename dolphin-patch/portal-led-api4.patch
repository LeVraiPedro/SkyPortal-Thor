+JNIEXPORT jlongArray JNICALL
+Java_org_dolphinemu_dolphinemu_features_skylanders_SkylanderConfig_getPortalLedState(JNIEnv* env,
+                                                                                     jclass clazz)
+{
+  constexpr jlong schema_version = 1;
+  const auto snapshot = Core::System::GetInstance().GetSkylanderPortal().GetLEDStateSnapshot();
+  const std::array<jlong, 12> packed = {
+      schema_version,
+      snapshot.active ? 1 : 0,
+      static_cast<jlong>(snapshot.sequence),
+      snapshot.left.red,
+      snapshot.left.green,
+      snapshot.left.blue,
+      snapshot.right.red,
+      snapshot.right.green,
+      snapshot.right.blue,
+      snapshot.trap.red,
+      snapshot.trap.green,
+      snapshot.trap.blue,
+  };
+  jlongArray result = env->NewLongArray(static_cast<jsize>(packed.size()));
+  env->SetLongArrayRegion(result, 0, static_cast<jsize>(packed.size()), packed.data());
+  return result;
+}
