+TEST(Skylanders, LedSnapshotTracksOnlyVisibleChanges)
+{
+  IOS::HLE::USB::SkylanderPortal portal;
+
+  auto snapshot = portal.GetLEDStateSnapshot();
+  EXPECT_TRUE(snapshot.active);
+  EXPECT_EQ(snapshot.sequence, 0);
+  EXPECT_EQ(snapshot.left.red, 0);
+  EXPECT_EQ(snapshot.right.red, 0);
+  EXPECT_EQ(snapshot.trap.red, 0);
+
+  portal.SetLEDs(0x01, 10, 20, 30);
+  snapshot = portal.GetLEDStateSnapshot();
+  EXPECT_EQ(snapshot.sequence, 1);
+  EXPECT_EQ(snapshot.left.red, 10);
+  EXPECT_EQ(snapshot.left.green, 20);
+  EXPECT_EQ(snapshot.left.blue, 30);
+  EXPECT_EQ(snapshot.right.red, 10);
+  EXPECT_EQ(snapshot.right.green, 20);
+  EXPECT_EQ(snapshot.right.blue, 30);
+
+  // A duplicate command must not create an artificial sequence advance.
+  portal.SetLEDs(0x01, 10, 20, 30);
+  EXPECT_EQ(portal.GetLEDStateSnapshot().sequence, 1);
+
+  portal.SetLEDs(0x00, 40, 50, 60);
+  snapshot = portal.GetLEDStateSnapshot();
+  EXPECT_EQ(snapshot.sequence, 2);
+  EXPECT_EQ(snapshot.left.red, 10);
+  EXPECT_EQ(snapshot.right.red, 40);
+
+  // The Trap Team audio-light command translates the left position to side 0x04.
+  portal.SetLEDs(0x04, 70, 80, 90);
+  snapshot = portal.GetLEDStateSnapshot();
+  EXPECT_EQ(snapshot.sequence, 3);
+  EXPECT_EQ(snapshot.left.red, 70);
+  EXPECT_EQ(snapshot.right.red, 40);
+
+  portal.SetLEDs(0x03, 100, 110, 120);
+  snapshot = portal.GetLEDStateSnapshot();
+  EXPECT_EQ(snapshot.sequence, 4);
+  EXPECT_EQ(snapshot.trap.red, 100);
+  EXPECT_EQ(snapshot.trap.green, 110);
+  EXPECT_EQ(snapshot.trap.blue, 120);
+
+  portal.Deactivate();
+  snapshot = portal.GetLEDStateSnapshot();
+  EXPECT_FALSE(snapshot.active);
+  EXPECT_EQ(snapshot.sequence, 5);
+
+  portal.Deactivate();
+  EXPECT_EQ(portal.GetLEDStateSnapshot().sequence, 5);
+
+  portal.Activate();
+  snapshot = portal.GetLEDStateSnapshot();
+  EXPECT_TRUE(snapshot.active);
+  EXPECT_EQ(snapshot.sequence, 6);
+}
